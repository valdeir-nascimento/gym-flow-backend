meta {
  name: 01 Register Exercise for Training (201)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/exercises
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
  X-User-Id: {{adminId}}
  X-User-Role: ADMINISTRATOR
}

body:json {
  {
    "name": "Agachamento Livre",
    "muscleGroup": "LEGS",
    "difficultyLevel": "INTERMEDIATE"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("exerciseId", res.getBody().id);
  }
}

assert {
  res.status: eq 201
}

docs {
  Ensures an ACTIVE exercise exists for the training flows (independent of the
  Exercises folder, which may deactivate its own). Captures exerciseId.
}
