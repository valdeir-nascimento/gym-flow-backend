meta {
  name: List by Student (200)
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/trainings?studentId={{studentId}}&page=0&size=20
  body: none
  auth: none
}

params:query {
  studentId: {{studentId}}
  page: 0
  size: 20
}

headers {
  Authorization: Bearer {{accessToken}}
  X-User-Id: {{studentId}}
  X-User-Role: STUDENT
}

assert {
  res.status: eq 200
  res.body.totalElements: isNumber
}

docs {
  RF-006 — the student lists their own trainings (paginated, status per item).
}
