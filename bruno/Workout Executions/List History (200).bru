meta {
  name: List History (200)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/workout-executions?studentId={{studentId}}&page=0&size=20
  body: none
  auth: none
}

params:query {
  studentId: {{studentId}}
  page: 0
  size: 20
}

headers {
  Authorization: Bearer {{accessToken}}
  X-User-Id: {{studentId}}
  X-User-Role: STUDENT
}

assert {
  res.status: eq 200
  res.body.totalElements: isNumber
}

docs {
  RF-009 — the student's activity history, paginated, most recent first. Optional
  filters: trainingId, exerciseId, startedFrom, startedTo.
}
