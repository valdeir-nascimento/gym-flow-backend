meta {
  name: Register - name taken (409)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/exercises
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
  X-User-Id: {{adminId}}
  X-User-Role: ADMINISTRATOR
}

body:json {
  {
    "name": "Supino Reto com Barra",
    "muscleGroup": "CHEST",
    "difficultyLevel": "INTERMEDIATE"
  }
}

assert {
  res.status: eq 409
}

