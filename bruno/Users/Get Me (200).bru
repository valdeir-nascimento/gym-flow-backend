meta {
  name: Get Me (200)
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/users/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  X-User-Id: {{adminId}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{adminId}}
}

docs {
  RF-015 — resolves the current user from the X-User-Id header.
}
