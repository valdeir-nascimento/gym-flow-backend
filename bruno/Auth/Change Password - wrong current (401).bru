meta {
  name: Change Password - wrong current (401)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/auth/change-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
  X-User-Id: {{adminId}}
}

body:json {
  {
    "currentPassword": "SenhaAtualErrada@1",
    "newPassword": "OutraSenha@2028",
    "passwordConfirmation": "OutraSenha@2028",
    "currentRefreshToken": "{{refreshToken}}"
  }
}

assert {
  res.status: eq 401
}

docs {
  RF-015 — current password incorrect -> 401 (no indication of which field).
}
