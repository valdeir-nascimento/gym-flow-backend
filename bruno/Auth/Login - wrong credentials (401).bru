meta {
  name: Login - wrong credentials (401)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "SenhaErrada@000"
  }
}

assert {
  res.status: eq 401
}
