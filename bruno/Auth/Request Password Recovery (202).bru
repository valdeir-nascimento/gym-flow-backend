meta {
  name: Request Password Recovery (202)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/password-recovery
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}"
  }
}

assert {
  res.status: eq 202
}

docs {
  RF-014 — always 202 (neutral, anti-enumeration), whether or not the e-mail
  exists. When eligible, a reset e-mail with a single-use token is sent.
}
