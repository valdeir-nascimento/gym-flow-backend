meta {
  name: Consume Invite - password mismatch (400)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/invites/{{bootstrapInvite}}/consume
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "newPassword": "Senha@1234",
    "passwordConfirmation": "Outra@1234"
  }
}

assert {
  res.status: eq 400
}

docs {
  RF-013 — confirmation differs from the new password -> 400. (Bean validation
  also rejects blank fields with 400.)
}
