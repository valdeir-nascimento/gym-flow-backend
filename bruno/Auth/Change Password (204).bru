meta {
  name: Change Password (204)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/auth/change-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
  X-User-Id: {{adminId}}
}

body:json {
  {
    "currentPassword": "{{adminPassword}}",
    "newPassword": "AdminSenha@2027",
    "passwordConfirmation": "AdminSenha@2027",
    "currentRefreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  // Keep the collection consistent: future logins must use the new password.
  if (res.getStatus() === 204) {
    bru.setEnvVar("adminPassword", "AdminSenha@2027");
  }
}

assert {
  res.status: eq 204
}

docs {
  RF-015 — self-service password change. Run intentionally: it MUTATES the admin
  password (the post-response script updates `adminPassword`). The current
  session's refresh token is preserved; the user's other sessions are revoked.
}
