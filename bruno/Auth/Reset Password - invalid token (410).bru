meta {
  name: Reset Password - invalid token (410)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/auth/password-reset/token-de-reset-invalido
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "newPassword": "NovaSenha@2026",
    "passwordConfirmation": "NovaSenha@2026"
  }
}

assert {
  res.status: eq 410
}

docs {
  RF-014 — reset token unknown / expired / consumed -> 410 Gone. For the success
  path (204), copy a real token from the recovery e-mail into the URL.
}
