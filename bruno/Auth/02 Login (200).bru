meta {
  name: 02 Login (200)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("accessToken", res.getBody().accessToken);
    bru.setEnvVar("refreshToken", res.getBody().refreshToken);
  }
}

assert {
  res.status: eq 200
  res.body.accessToken: isString
  res.body.role: eq ADMINISTRATOR
}

docs {
  RF-003 — captures accessToken/refreshToken into the environment for every
  protected request that follows.
}
