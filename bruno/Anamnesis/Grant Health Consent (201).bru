meta {
  name: Grant Health Consent (201)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users/{{studentId}}/health-consent
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  X-User-Id: {{adminId}}
  X-User-Role: ADMINISTRATOR
}

assert {
  res.status: eq 201
  res.body.studentId: eq {{studentId}}
}

docs {
  RF-017 / RNF-008 — records the student's health-data consent (by the student
  or an admin). Idempotent. Prerequisite for registering an anamnesis.
}
